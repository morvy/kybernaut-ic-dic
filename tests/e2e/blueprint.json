{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"preferredVersions": {
		"wp": "6.7",
		"php": "8.1"
	},
	"landingPage": "/checkout/",
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://downloads.wordpress.org/plugin/woocommerce.10.0.0.zip"
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "woolab-ic-dic/woolab-ic-dic.php"
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; require WP_PLUGIN_DIR . '/woolab-ic-dic/tests/e2e/setup.php';"
		}
	]
}
