{
  "name": "woolab-ic-dic",
  "version": "1.0.0",
  "description": "[![plugin version](https://img.shields.io/wordpress/plugin/v/woolab-ic-dic.svg)](https://wordpress.org/plugins/woolab-ic-dic)",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@wordpress/scripts": "36.1.0",
    "@wp-playground/cli": "3.1.60"
  },
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "test:e2e": "npm run test:e2e:min && npm run test:e2e:latest",
    "test:e2e:min": "node tests/e2e/stack.js min && playwright test -c tests/e2e/playwright.config.js",
    "test:e2e:latest": "node tests/e2e/stack.js latest && playwright test -c tests/e2e/playwright.config.js",
    "test:e2e:site": "playwright test -c tests/e2e/playwright.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vyskoczilova/kybernaut-ic-dic.git"
  },
  "author": "Karolina Vyskocilova",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/vyskoczilova/kybernaut-ic-dic/issues"
  },
  "homepage": "https://github.com/vyskoczilova/kybernaut-ic-dic#readme"
}
