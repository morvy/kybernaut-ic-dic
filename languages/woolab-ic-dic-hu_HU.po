msgstr "A cégjegyzékszámnak 8 számjegyből kell állnia."

#: src/Services/Ares/Ares.php:65
msgid "An error occured while connecting to ARES, try it again later."
msgstr "Nem sikerült csatlakozni az ARES-hez, próbáld újra később."

