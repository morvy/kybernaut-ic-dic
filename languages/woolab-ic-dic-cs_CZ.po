msgstr "Stav"

#: includes/settings.php:422
msgid "Last import"
msgstr "Poslední import"

#. translators: 1: number of DIČ, 2: number of IČ DPH
#: includes/settings.php:424
#, php-format
msgid "%1$s DIČ, %2$s IČ DPH"
msgstr "%1$s DIČ, %2$s IČ DPH"

#: includes/settings.php:425
msgid "Database"
msgstr "Databáze"

#: includes/settings.php:426
msgid "The file is missing, the next import creates it again."
msgstr "Soubor chybí, nejbližší import ho vytvoří znovu."

#: includes/settings.php:431
msgid "Last failed import"
msgstr "Poslední neúspěšný import"

#: includes/settings.php:436
msgid "Not scheduled, it is scheduled again on the next page load."
msgstr "Nenaplánováno, naplánuje se znovu při nejbližším načtení stránky."

#. translators: %s: date and time
#: includes/settings.php:439
#, php-format
msgid "%s, overdue: WP-Cron has not run since. It runs on page visits, or set up a server cron job for wp-cron.php."
