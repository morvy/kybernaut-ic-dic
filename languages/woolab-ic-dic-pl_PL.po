#: src/Services/Ares/Ares.php:65
msgid "An error occured while connecting to ARES, try it again later."
msgstr "Wystąpił błąd podczas łączenia z rejestrem ARES. Spróbuj ponownie później."

#: src/Services/Ares/Ares.php:131
msgid "Entity doesn't exist in ARES."
