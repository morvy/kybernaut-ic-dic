#: src/Order/Privacy.php:173
#, php-format
msgid "The VAT ID check of order %s has been retained: it is part of the VAT records the shop must keep (Directive 2006/112/EC, Art. 242–249)."
msgstr "Weryfikacja NIP-UE zamówienia %s została zachowana: jest częścią ewidencji VAT, którą sklep musi przechowywać (dyrektywa 2006/112/WE, art. 242–249)."

