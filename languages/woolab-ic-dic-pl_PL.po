msgstr "Rejestr ARES nie odpowiada."

#: src/Services/FinancnaSprava/FinancnaSprava.php:110
msgid "Finančná správa lists are not available."
msgstr "Listy Finančná správa nie są dostępne."

#: src/Services/FinancnaSprava/FinancnaSprava.php:117
msgid "Business ID not found in Finančná správa, fill in the details manually."
msgstr "Nie znaleziono numeru identyfikacyjnego firmy w bazie Finančná správa. Uzupełnij dane ręcznie."

#: src/Services/FinancnaSprava/Importer.php:79
msgid "Kybernaut IČO DIČ: the Finančná správa DIČ / IČ DPH lists are missing or older than a week, so those numbers cannot be validated. The import runs daily through WP-Cron (or run \"wp woolab-icdic sk-import\"); failures are logged in WooCommerce → Status → Logs."
msgstr "Kybernaut IČO DIČ: listy DIČ / IČ DPH z Finančná správa nie zostały zaimportowane lub są starsze niż tydzień, więc tych numerów nie można zweryfikować. Import uruchamia się codziennie przez WP-Cron (możesz też uruchomić „wp woolab-icdic sk-import”); błędy są zapisywane w WooCommerce → Status → Dziennik zdarzeń."

#: src/Services/FinancnaSprava/Importer.php:80
#: src/Settings/Fields.php:162
msgid "Kybernaut IČO DIČ: the Finančná správa DIČ / IČ DPH lists cannot be imported, the zip, xmlreader and pdo_sqlite PHP extensions are required (ask your hosting)."
msgstr "Kybernaut IČO DIČ: nie można zaimportować list DIČ / IČ DPH z Finančná správa, ponieważ brakuje rozszerzeń PHP zip, xmlreader i pdo_sqlite (zapytaj dostawcę hostingu)."

#: src/Services/FinancnaSprava/Importer.php:82
#: src/Settings/Fields.php:160
