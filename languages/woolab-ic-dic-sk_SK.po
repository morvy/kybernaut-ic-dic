#: src/Settings/Fields.php:317
msgid "Leave empty for a tint of the text colour."
msgstr "Nechajte prázdne pre odtieň farby textu."

#: src/Settings/Fields.php:319
msgid "Corner radius"
msgstr "Zaoblenie rohov"

#: src/Settings/Fields.php:320
msgid "In pixels. Leave empty for the company field's own."
msgstr "V pixeloch. Nechajte prázdne pre zaoblenie poľa s názvom firmy."

#: src/Settings/Fields.php:347
msgid "Finančná správa lists"
msgstr "Zoznamy Finančnej správy"

#: src/Settings/Fields.php:349
msgid "The DIČ and IČ DPH lists the Slovak checks run against, imported daily."
msgstr "Zoznamy DIČ a IČ DPH, podľa ktorých sa overujú slovenské údaje, importované denne."

