#: includes/financna-sprava.php:93
msgid "Kybernaut IČO DIČ: the Finančná správa DIČ / IČ DPH lists are missing or older than a week, so those numbers cannot be validated. The import runs daily through WP-Cron (or run \"wp woolab-icdic sk-import\"); failures are logged in WooCommerce → Status → Logs."
msgstr "Kybernaut IČO DIČ: zoznamy DIČ / IČ DPH Finančnej správy chýbajú alebo sú staršie ako týždeň, preto tieto čísla nemožno overiť. Import beží denne cez WP-Cron (alebo spustite „wp woolab-icdic sk-import“); chyby sa zapisujú do WooCommerce → Stav → Záznamy."

#: includes/financna-sprava.php:94
#: includes/settings.php:230
msgid "Kybernaut IČO DIČ: the Finančná správa DIČ / IČ DPH lists cannot be imported, the zip, xmlreader and pdo_sqlite PHP extensions are required (ask your hosting)."
msgstr "Kybernaut IČO DIČ: zoznamy DIČ / IČ DPH Finančnej správy nemožno importovať, sú potrebné PHP rozšírenia zip, xmlreader a pdo_sqlite (opýtajte sa svojho poskytovateľa hostingu)."

