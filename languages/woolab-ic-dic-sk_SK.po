msgid "Czech Republic"
msgstr "Česko"

#: includes/settings.php:127
msgid "CZ: Validate Business ID in ARES"
msgstr "CZ: Overiť IČO v ARESe"

#: includes/settings.php:128
msgid "Enable validation of Business ID in Czech database ARES."
msgstr "Povoliť overenie hodnoty IČO v databáze ARES."

