#, php-format
msgid "Off. Enable \"SK: Validate in Finančná správa\" in %s."
msgstr "Vypnuté. Zapnite „SK: Overiť vo Finančnej správe“ v časti %s."

#: includes/settings.php:412
msgid "Up to date"
msgstr "Aktuálne"

#: includes/settings.php:414
msgid "Older than a week: Slovak numbers are checked in VIES only, or let through when \"ignore when the check fails\" is on."
msgstr "Staršie ako týždeň: slovenské čísla sa overujú len vo VIES, alebo sa prijmú, ak je zapnuté „ignorovať, keď overenie zlyhá“."

#: includes/settings.php:416
